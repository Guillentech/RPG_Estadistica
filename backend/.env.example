# Puerto del servidor Express (por defecto 4000)
PORT=4000

# Orígenes permitidos por CORS, separados por comas.
# Déjalo vacío en desarrollo local. En producción usa tu dominio:
# CORS_ORIGIN=https://app.tudominio.com,https://localhost
CORS_ORIGIN=

# Ruta opcional de SQLite. Por defecto: backend/database.sqlite
# En Docker se usa un volumen persistente, por ejemplo: /data/database.sqlite
DB_PATH=

# Carpeta opcional de adjuntos. Por defecto: backend/uploads
# En Docker se usa un volumen persistente, por ejemplo: /data/uploads
UPLOADS_DIR=

# Clave opcional de Google Gemini para el Copiloto IA.
# Si no se define, la app usa el generador local de respaldo.
GEMINI_API_KEY=
